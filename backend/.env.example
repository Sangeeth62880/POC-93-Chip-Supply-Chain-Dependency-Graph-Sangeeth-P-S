# Real Rails PoC #93 — Backend Environment Variables Template
# Copy this file to .env and configure as needed.

# Add API keys here if connecting to live data sources
UN_COMTRADE_API_KEY=
WORLD_BANK_API_KEY=

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3001,http://localhost:3002,http://localhost:3004
